# Runtime
OPENAI_API_KEY=
DATABASE_URL=

# BRS system knowledge ingestion. Keep these as secrets; never commit real values.
BRS_BASE_URL=https://brsgolf.com
BRS_CLUB_ID=harrysgolfclub
BRS_CLUB_IDS=
BRS_USERNAME=
BRS_PASSWORD=
BRS_LIVE_LOOKUP_ENABLED=false
BRS_LIVE_LOOKUP_TIMEOUT_MS=45000
# Free/low-cost production option: deploy browser-worker/ to Render/Railway/Fly
# and point the Vercel app at it. Use the same secret in both services.
BRS_LIVE_WORKER_URL=
BRS_LIVE_WORKER_SECRET=
# Recommended on Vercel/serverless: use a managed browser websocket endpoint,
# for example from Browserless. Keep this as a secret in production.
BRS_LIVE_BROWSER_WS_ENDPOINT=
# When a live-evidence answer is marked resolved with a high score, store the
# observed workflow in Postgres and reuse it in future chatbot retrieval.
BRS_LEARNING_AUTO_APPROVE=true
BRS_LEARNING_MIN_SCORE=70
BRS_LEARNING_STORE_APPROVED_STATIC=true
BRS_MAX_LEARNED_WORKFLOWS=80
BRS_CRAWL_MAX_PAGES=80
BRS_CRAWL_OUTPUT_DIR=knowledge/system
BRS_CRAWL_ALLOW_MUTATIONS=false

# Demo-only workflow exploration. This can create safe test bookings on a
# dedicated demo club so workflows can be observed end-to-end. It must never be
# pointed at a live customer club. Settings/setup mutations remain blocked.
BRS_DEMO_WORKFLOW_EXPLORATION_ENABLED=false
BRS_DEMO_ALLOW_BOOKING_CREATION=false
BRS_DEMO_CLUB_ID=
BRS_DEMO_USERNAME=
BRS_DEMO_PASSWORD=
BRS_DEMO_WORKFLOW_OUTPUT_DIR=knowledge/workflows/demo
# draft opens/fills booking forms for evidence; commit can submit demo bookings.
BRS_DEMO_BOOKING_CREATION_MODE=draft

# Local test-only chatbot actions. Keep disabled in production unless the flow
# has explicit approval controls and a dedicated test/sandbox account.
BRS_TIMESHEET_AUTOMATION_ENABLED=false
BRS_TIMESHEET_URL=https://brsgolf.com/exampleclub/
BRS_TIMESHEET_USERNAME=
BRS_TIMESHEET_PASSWORD=
BRS_AUTOMATION_HEADLESS=true

# Production auth/context placeholder. Keep false for local prototype use.
BRS_BOT_REQUIRE_AUTH=false
BRS_LOCAL_CLUB_ID=local-demo-club
BRS_LOCAL_USER_ID=local-prototype-user
BRS_LOCAL_PERMISSIONS=
BRS_LOCAL_ROLES=
