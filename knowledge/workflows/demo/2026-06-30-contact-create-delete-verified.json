  "entries": [
    {
      "id": "brs-demo-workflow:contact-create-delete-verified-2026-06-30",
      "sourceType": "brs-system-workflow",
      "title": "Create and delete a temporary contact",
      "area": "Contacts",
      "workflow": "Create, verify, and delete a contact",
      "summary": "Controlled demo workflow captured with a temporary disabled contact and verified cleanup. Use as product workflow evidence, not as live contact data.",
      "navigationPath": "Contacts >> Add New",
      "routes": [
        {
          "name": "Create a disabled contact and verify cleanup",
          "actor": "Admin or staff user with Contacts access",
          "preconditions": [
            "User is signed into the BRS admin area.",
            "The Contacts module is enabled for the club."
          ],
          "steps": [
            "Open \"Contacts\" from the main navigation menu.",
            "Click \"Add New\" on the Contacts page.",
            "Complete \"CompanyName\" and choose \"Other\" in \"Category\".",
            "Tick \"Disabled\" when creating a temporary or inactive contact.",
            "Use the contact detail fields such as \"Title1\", \"Firstname1\", \"Surname1\", \"Email1\", telephone fields, address fields, and \"CustomerNotes\" as needed.",
            "Leave marketing consent boxes such as \"Email\", \"Text Message\", \"Post\", and \"Phone\" unticked unless the contact has consented.",
            "Click \"Add\" to create the contact.",
            "Use contact search/view to confirm the contact appears.",
            "Open the contact record and click \"Delete\" to remove the temporary contact.",
            "Search again and confirm the temporary contact no longer appears."
          ],
          "outcome": "A temporary disabled contact can be created, found, deleted, and verified as removed.",
          "verification": [
            "Temporary test contact appeared in Contacts search after creation.",
            "Temporary test contact was deleted and no longer appeared in Contacts search.",
            "Cleanup verification was completed in a follow-up cleanup run for marker \"[temporary test contact]\".",
            "Post-submit message observed: General Information Company / Group Name: Contact Category: Company Hotel Other Society Tour Operator Visitor Disable Contact Title: Mr Mrs Miss Ms Dr Prof Sir Lady Lord Dame Col Capt Rev Fr Major Master First Name: Initials: Last Name: Position: Email: Telephone (Home): Telephone (Work): Mobile: Fax: Address Information: Address (line 1): Address (line 2): Town / City: County / State: Country: Argentina Austria Australia Bahrain Barbados Belgium Bermuda Canada China Denmark England Finland France Germany Iceland India Ireland Isle of Man Israel Italy Japan Kuwait Lebanon Malaysia Malta Mexico Netherlands New Zealand Norway Northern Ireland Oman Papua New Guinea Poland Portugal Qatar Saudi Arabia Scotland Singapore South Africa South Korea Spain Sweden Switzerland Thailand United Arab Emirates United Kingdom United States Wales Other Postcode / Zip: Club Details: Club Name: Handicap: CDH: Marketing Preferences: Email Text Message Post Phone I have made the contact aware of the Marketing Consent message Privacy Policy and Visitor Terms and Conditions: The contact has read and accepted the Privacy Policy and Visitor Terms and Conditions."
          ]
        }
      ],
